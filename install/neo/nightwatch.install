#!/bin/bash

## Description: Run Nightwatch browser tests inside the web container
## Usage: nightwatch [tag] [flags]
## Example: "ddev nightwatch" or "ddev nightwatch neo_modal" or "ddev nightwatch neo_modal --no-build"
## ProjectTypes: drupal8,drupal9,drupal10,drupal11
## ExecRaw: true

# Generated by `drush neo:build:install`. Safe to edit — the installer will not
# overwrite an existing copy.

if [ -z "${DRUPAL_TEST_WEBDRIVER_HOSTNAME}" ]; then
  echo "DRUPAL_TEST_WEBDRIVER_HOSTNAME is not set; Nightwatch has no browser to drive."
  echo "Install the selenium add-on, then 'ddev restart':"
  echo "  ddev add-on get ddev/ddev-selenium-standalone-chrome"
  exit 1
fi

if ! curl -sf "http://${DRUPAL_TEST_WEBDRIVER_HOSTNAME}:${DRUPAL_TEST_WEBDRIVER_PORT}/status" >/dev/null 2>&1; then
  echo "No webdriver answering at ${DRUPAL_TEST_WEBDRIVER_HOSTNAME}:${DRUPAL_TEST_WEBDRIVER_PORT}."
  echo "Is the selenium-chrome container running? Try 'ddev restart'."
  exit 1
fi

# neo-cli owns the dev-mode guard, the asset build and core's one-time yarn
# install. Everything after the command name is passed through.
exec node [ROOT]/[DOC-ROOT][MODULE-DIR]/tools/neo-cli.cjs test "$@"
