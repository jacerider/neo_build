<?php

/**
 * @file
 * Install, update and uninstall functions for the Neo Build module.
 */

use Drupal\Core\Extension\Requirement\RequirementSeverity;
use Drupal\neo_build\EntityPrintSubmoduleInstaller;

/**
 * Implements hook_requirements().
 */
function neo_build_requirements($phase) {
  $requirements = [];

  if ($phase == 'runtime') {
    $config = \Drupal::config('neo_build.info');
    $versions = [];
    $builtVersions = [];

    /** @var \Drupal\neo_build\NeoExtensionList $neoExtensionList */
    $neoExtensionList = \Drupal::service('extension.list.neo');
    $extensions = $neoExtensionList->all();
    ksort($extensions);

    foreach ($extensions as $name => $extension) {
      $versions[$name] = $extension->getVersion();
      $builtVersions[$name] = $config->get('versions.' . $name) ?? NULL;
    }

    $requirements['neo_build'] = [
      'title' => t('Neo Build'),
      'value' => t('The Neo Build module provides a build system for Drupal modules and themes using Vite.'),
      'description' => [
        '#type' => 'table',
        '#header' => [
          'extension' => t('Extension'),
          'version' => t('Installed Version'),
          'built_version' => t('Built Version'),
        ],
        '#neo_style' => [
          'version' => 'xs',
          'built_version' => 'xs',
        ],
        '#neo_size' => [
          'version' => 'min',
          'built_version' => 'min',
        ],
      ],
    ];

    foreach ($extensions as $name => $extension) {
      $currentVersion = $versions[$name] ?? '0.0.0';
      $newVersion = $builtVersions[$name] ?? NULL;
      $row = [
        'extension' => '(' . ucwords($extension->getType()) . ') ' . $extension->getLabel(),
        'version' => $currentVersion,
        'built_version' => [
          'data' => [
            '#prefix' => '<span class="text-success">',
            '#suffix' => '</span>',
            '#markup' => $newVersion ? $newVersion : t('All modules and themes that support Neo Build are compiled.'),
          ],
        ],
      ];
      if (!$newVersion || version_compare($currentVersion, $newVersion, '>')) {
        $requirements['neo_build']['severity'] = RequirementSeverity::Error;
        $requirements['neo_build']['value'] = t('Some modules or themes that require Neo Build have not been compiled or have been updated since the last compile. Please run the Neo build command <code>(npm run deploy)</code>.');
        $row['built_version']['data']['#prefix'] = '<span class="text-alert">';
      }
      $requirements['neo_build']['description']['#rows'][] = [
        'data' => $row,
      ];
    }
  }

  return $requirements;
}

/**
 * Enable neo_build_entity_print where entity_print is enabled.
 *
 * The dev-mode entity_print asset shim moved out of neo_build into the
 * optional neo_build_entity_print submodule, so neo_build passes PHPStan on
 * sites without entity_print. Sites with entity_print enabled get the
 * submodule enabled here and the shim keeps working without anyone doing
 * anything by hand; sites without entity_print are untouched.
 */
function neo_build_update_11001() {
  $installer = new EntityPrintSubmoduleInstaller(\Drupal::moduleHandler(), \Drupal::service('module_installer'));
  if ($installer->installWhereEntityPrintIsEnabled()) {
    return (string) t('Enabled neo_build_entity_print: entity_print is enabled on this site and the dev-mode print-asset shim now lives there.');
  }
  return NULL;
}
