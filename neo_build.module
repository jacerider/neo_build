<?php

/**
 * @file
 * NeoBuild module.
 */

use Drupal\Component\Utility\Html;
use Drupal\Core\Routing\RouteMatchInterface;
use Drupal\neo_build\Exception\ManifestCouldNotBeLoadedException;
use Drupal\neo_build\Exception\ManifestNotFoundException;
use Drupal\neo_build\Scope;

/**
 * Implements hook_library_info_alter().
 *
 * Process libraries configured with vite.
 */
function neo_build_library_info_alter(array &$libraries, string $extension) : void {
  try {
    \Drupal::service('neo_build')->processLibraries($libraries, $extension);
  }
  catch (ManifestNotFoundException | ManifestCouldNotBeLoadedException $e) {
    // A missing or unreadable manifest means this extension has no built assets
    // to rewrite; leave its libraries as declared.
  }
  if ($extension === 'canvas') {
    if (isset($libraries['canvas-ui'])) {
      $libraries['canvas-ui']['dependencies'][] = 'neo_build/back';
    }
  }
}

/**
 * Implements hook_module_implements_alter().
 */
function neo_build_module_implements_alter(&$implementations, $hook) {
  if ($hook == 'library_info_alter') {
    $group = $implementations['neo_build'];
    unset($implementations['neo_build']);
    $implementations['neo_build'] = $group;
  }
}

/**
 * Implements hook_help().
 */
function neo_build_help(string $route_name, RouteMatchInterface $route_match) : string {
  switch ($route_name) {
    case 'help.page.neo_build':
      $text = file_get_contents(__DIR__ . '/README.md');
      if ($text === FALSE) {
        return '';
      }

      if (!\Drupal::moduleHandler()->moduleExists('markdown')) {
        return '<pre>' . Html::escape($text) . '</pre>';
      }
      else {
        // Use the Markdown filter to render the README.
        $filter_manager = \Drupal::service('plugin.manager.filter');
        $settings = \Drupal::configFactory()->get('markdown.settings')->getRawData();
        $config = ['settings' => $settings];
        /** @var \Drupal\filter\Plugin\FilterInterface */
        $filter = $filter_manager->createInstance('markdown', $config);
        return $filter->process($text, 'en');
      }
  }
  return '';
}

/**
 * Implements hook_library_info_build().
 */
function neo_build_library_info_build() : array {
  $libraries = [];
  foreach (Scope::cases() as $scope) {
    $libraries[$scope->value] = [
      'css' => [
        'theme' => [
          'public://neo-build/' . $scope->value . '.css' => [],
        ],
      ],
    ];
  }
  return $libraries;
}

/**
 * Implements hook_rebuild().
 */
function neo_build_rebuild() {
  \Drupal::service('neo_build.inline_css_generator')->generate();
}

/**
 * Implements hook_page_top().
 */
function neo_build_page_top(array &$page_top) {
  if (\Drupal::service('neo_build')->isDevMode()) {
    // Disable big pipe while in dev mode.
    \Drupal::routeMatch()->getRouteObject()->setOption('_no_big_pipe', TRUE);
  }
  // Safety net: ensure CSS files exist (cold start / files directory cleared).
  \Drupal::service('neo_build.inline_css_generator')->ensureGenerated();
}

/**
 * Implements hook_preprocess_HOOK() for maintenance page.
 *
 * Adds the page top to the maintenance page.
 */
function neo_build_preprocess_maintenance_page(array &$variables) {
  neo_build_page_top($variables['page']['content']);
}
